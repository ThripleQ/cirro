# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Local configuration
local.properties
# Machine-generated by `gradlew updateDaemonJvm`; pins the daemon JVM to this machine.
# CI builds with setup-java (JDK 21), so keep it out of the repo.
gradle/gradle-daemon-jvm.properties

# IDE
.idea/
*.iml
.vscode/
.cxx/
.kotlin/

# Android
captures/
.externalNativeBuild/
.cxx/

# OS
.DS_Store
Thumbs.db

# Keystore / secrets — never commit
*.jks
*.keystore
keystore.properties
keystore
# Python（tools/ 下脚本）
__pycache__/
*.pyc

# debug 签名密钥是有意提交的（无安全价值，密码固定 android）——
# 固化它是为了让 CI 产出的 debug APK 与本地同签名，可直接覆盖安装。
!app/debug.keystore
