<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose renders the full UI; the platform theme just needs to provide
         a no-action-bar surface and let the app go edge-to-edge. Must NOT be
         Light-only: a forced-light theme keeps the app light even when the
         system is in dark mode, so text never switches to the light-on-dark
         colors. DayNight follows the system. -->
    <style name="Theme.Cirro" parent="android:Theme.Material.NoActionBar">
        <!-- 窗口底色锚到 Compose 的 surface（浅色 / 深色各一份，深色见 values-night）。
             不定死的话，父主题用的是平台深色 Material 的默认底 —— 浅色模式下启动、
             旋转、从多任务切回时会露一帧深灰。 -->
        <item name="android:windowBackground">@color/cirro_window_background</item>
    </style>

    <!-- Launch theme: covers the window before the first Compose frame, then hands
         over to Theme.Cirro. Only the brand-red backdrop is used here — the mark is
         drawn (and animated) by ui/splash/SplashOverlay.kt, see splash_window_icon. -->
    <style name="Theme.Cirro.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cirro_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_window_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Cirro</item>
    </style>
</resources>